# --- Firebase web app (public, sent to the browser) ---
# Firebase Console → Project settings → General → Your apps → Web app → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional, for the evening reminder: Firebase Console → Settings → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=

# --- Firebase Admin (server only, NEVER commit real values) ---
# Firebase Console → Project settings → Service accounts → Generate new private key
# Copy project_id, client_email, and private_key from the downloaded JSON.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the quotes and the \n sequences exactly as in the JSON file.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional, for the evening reminder: any long random string (Vercel sends it to the cron route)
CRON_SECRET=

# Optional, for Saran Belajar: API key from console.anthropic.com (billed separately from Claude.ai)
ANTHROPIC_API_KEY=

# Optional: username for the first admin (default: admin)
ADMIN_USERNAME=admin
